{
  "api": {
    "listen": "127.0.0.1:10086",
    "services": [
      "HandlerService",
      "StatsService"
    ],
    "tag": "api"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": 13333,
      "protocol": "vless",
      "settings": {
        "decryption": "none",
        "users": []
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "path": "/REPLACE_WITH_RANDOM_WS_PATH",
          "acceptProxyProtocol": false
        }
      },
      "tag": "vless-ws"
    }
  ],
  "log": {
    "access": "/var/log/xray-ws/access.log",
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    }
  ],
  "policy": {
    "levels": {
      "0": {
        "statsUserDownlink": true,
        "statsUserOnline": true,
        "statsUserUplink": true
      }
    }
  },
  "stats": {}
}
